<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="PegasusLocal" value="dependencies/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="PegasusLocal">
      <package pattern="Pegasus.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <!-- The more-specific Pegasus.* mapping keeps suite packages on the bundled feed. -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

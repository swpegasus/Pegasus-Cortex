{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasus.local/schemas/cortex/learning-feedback-review-grant.v1.schema.json",
  "title": "Pegasus Cortex Learning Feedback Review Grant v1",
  "description": "An immutable collective-only, time-limited, use-limited delegation to one independent auditor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractId", "canonicalization", "grantId", "tenantId",
    "namespace", "authorityId", "issuerSubjectId", "delegateAuthorityId",
    "delegateSubjectId", "policyRevision", "feedbackKinds", "collectiveOnly",
    "maximumUses", "expiresAt", "createdAt", "grantHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "pegasus.cortex.learning-feedback-review-grant/1.0" },
    "canonicalization": { "const": "pegasus-canonical-json-v1" },
    "grantId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "namespace": { "const": "collective" },
    "authorityId": { "$ref": "#/$defs/identifier" },
    "issuerSubjectId": { "$ref": "#/$defs/identifier" },
    "delegateAuthorityId": { "$ref": "#/$defs/identifier" },
    "delegateSubjectId": { "$ref": "#/$defs/identifier" },
    "policyRevision": { "type": "integer", "minimum": 1 },
    "feedbackKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["quality", "success"] }
    },
    "collectiveOnly": { "const": true },
    "maximumUses": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "grantHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasus.local/schemas/cortex/cortex-sync-legacy-migration-inventory.v1.schema.json",
  "title": "Pegasus Cortex portable ordered legacy migration inventory v1",
  "description": "Hash-sealed portable projection of the exact source manifest inventory. It carries no absolute paths, authorization, cleanup, or cutover authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractId", "canonicalization", "migrationId", "sourceManifestHash",
    "storeId", "storeEpoch", "projectId", "sourceRootId", "capturedAt",
    "sourcePathCaseSensitive", "files", "totalSourceBytes", "contentTreatment",
    "executable", "extensions", "inventoryHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "pegasus.cortex.legacy-migration-inventory/1.0" },
    "canonicalization": { "const": "pegasus-canonical-json-v1" },
    "migrationId": { "$ref": "#/$defs/identifier" },
    "sourceManifestHash": { "$ref": "#/$defs/hash" },
    "storeId": { "$ref": "#/$defs/identifier" },
    "storeEpoch": { "$ref": "#/$defs/identifier" },
    "projectId": { "$ref": "#/$defs/identifier" },
    "sourceRootId": { "$ref": "#/$defs/identifier" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sourcePathCaseSensitive": { "type": "boolean" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": { "$ref": "#/$defs/file" }
    },
    "totalSourceBytes": { "type": "integer", "minimum": 0, "maximum": 68719476736 },
    "contentTreatment": { "const": "untrusted_data" },
    "executable": { "const": false },
    "extensions": { "$ref": "#/$defs/extensions" },
    "inventoryHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^:\u0000-\u001F\u007F]+$"
    },
    "contractId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*/[0-9]+\\.[0-9]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileIndex", "role", "sourceRelativePath", "sourceBytes", "sourceSha256", "recordId", "revisionId", "chunkCount"],
      "properties": {
        "fileIndex": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "role": { "$ref": "#/$defs/identifier" },
        "sourceRelativePath": { "$ref": "#/$defs/relativePath" },
        "sourceBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "recordId": { "$ref": "#/$defs/identifier" },
        "revisionId": { "$ref": "#/$defs/identifier" },
        "chunkCount": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "required", "payloadBase64Url", "payloadBytes", "payloadSha256"],
      "properties": {
        "contractId": { "$ref": "#/$defs/contractId" },
        "required": { "type": "boolean" },
        "payloadBase64Url": { "type": "string", "minLength": 2, "maxLength": 21848, "pattern": "^[A-Za-z0-9_-]+$" },
        "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "payloadSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "extensions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/extension" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pegasus.local/cortex/default-library-bundle.v1.schema.json",
  "title": "Pegasus Cortex Default Library Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractId", "bundleId", "releaseVersion", "nuGetVersion",
    "generatedAt", "taxonomies", "records", "contentTreatment", "executable", "bundleHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "pegasus.cortex.default-library-bundle/1.0" },
    "bundleId": { "type": "string", "pattern": "^kbundle_[0-9a-f]{64}$" },
    "releaseVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[A-D]$" },
    "nuGetVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]{8}\\.[0-9]{1,4}-[a-d]$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "taxonomies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/taxonomy" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/record" }
    },
    "contentTreatment": { "const": "untrusted_data" },
    "executable": { "const": false },
    "bundleHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "displayName", "description"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "componentId", "minimumVersion", "maximumVersion", "state"],
      "properties": {
        "productId": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "minimumVersion": { "type": ["string", "null"] },
        "maximumVersion": { "type": ["string", "null"] },
        "state": { "enum": ["verified", "blocked", "unverified", "unknown", "stale"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "mediaType", "sha256", "verification", "observedAt", "sourceVersion"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verification": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceVersion": { "type": ["string", "null"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "recordId", "revisionId", "namespace", "taxonomy", "slug", "title",
        "summary", "content", "keywords", "applicability", "evidence", "provenance", "confidence",
        "freshness", "sensitivity", "retention", "recordStatus", "approval", "promotion",
        "supersession", "trainingEligibility", "contentTreatment", "executable", "createdAt", "contentHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordId": { "type": "string", "pattern": "^krec_[0-9a-f]{64}$" },
        "revisionId": { "type": "string", "pattern": "^krev_[0-9a-f]{64}$" },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
        "taxonomy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "content": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "keywords": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
        "applicability": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/applicability" } },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/evidence" } },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producerContract", "sourceRecordIds", "transformations"],
          "properties": {
            "producerContract": { "const": "pegasus.cortex.knowledge-record/1.0" },
            "sourceRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "type": "string", "minLength": 1 }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "observedAt", "reviewAfter", "basis"],
          "properties": {
            "state": { "enum": ["current", "stale", "blocked", "unverified", "unknown"] },
            "observedAt": { "type": "string", "format": "date-time" },
            "reviewAfter": { "type": ["string", "null"], "format": "date-time" },
            "basis": { "type": "string", "minLength": 1 }
          }
        },
        "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "retainUntil", "legalHold"],
          "properties": {
            "class": { "enum": ["ephemeral", "operational", "knowledge", "decision", "audit"] },
            "retainUntil": { "type": ["string", "null"], "format": "date-time" },
            "legalHold": { "type": "boolean" }
          }
        },
        "recordStatus": { "enum": ["active", "superseded", "archived"] },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "policyRevision", "approvedBy", "approvedAt"],
          "properties": {
            "state": { "enum": ["pending", "approved", "rejected"] },
            "policyRevision": { "type": "integer", "minimum": 0 },
            "approvedBy": { "type": ["string", "null"] },
            "approvedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "sourceRecordId", "targetNamespace"],
          "properties": {
            "state": { "enum": ["none", "seeded", "proposed", "approved", "rejected"] },
            "sourceRecordId": { "type": ["string", "null"] },
            "targetNamespace": { "type": ["string", "null"] }
          }
        },
        "supersession": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supersedesRevisionIds"],
          "properties": {
            "supersedesRevisionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^krev_[0-9a-f]{64}$" } }
          }
        },
        "trainingEligibility": { "const": false },
        "contentTreatment": { "const": "untrusted_data" },
        "executable": { "const": false },
        "createdAt": { "type": "string", "format": "date-time" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

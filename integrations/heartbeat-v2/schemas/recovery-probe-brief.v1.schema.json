{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasus.local/schemas/recovery-probe-brief.v1.schema.json",
  "title": "Pegasus Cortex internal disposable recovery-probe brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "rootId",
    "contextSetId",
    "generatedAtUtc",
    "expiresAtUtc",
    "maxAgeSeconds",
    "currentTask",
    "gate",
    "nextAction",
    "checkpoint",
    "recoveryOrder",
    "sourceHashes",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "pegasus.cortex.recovery-probe-brief/1.0"
    },
    "project": {
      "const": "Pegasus Cortex"
    },
    "rootId": {
      "type": "string",
      "pattern": "^root_[0-9a-f]{32}$"
    },
    "contextSetId": {
      "type": "string",
      "pattern": "^ctx_[0-9a-f]{32}$"
    },
    "generatedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expiresAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "maxAgeSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 604800
    },
    "currentTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8,64}$"
        },
        "status": {
          "const": "active"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 520
        }
      }
    },
    "gate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640
    },
    "nextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 760
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "claim"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^1\\.[0-9]{4}(?:\\.[0-9]{2}){4}\\.[A-Z]$"
        },
        "claim": {
          "const": "accepted-source"
        }
      }
    },
    "recoveryOrder": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceHashes": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localFilesDecisive",
        "disposable",
        "failClosedOnStaleOrMismatch",
        "parentTranscriptInherited"
      ],
      "properties": {
        "localFilesDecisive": {
          "const": true
        },
        "disposable": {
          "const": true
        },
        "failClosedOnStaleOrMismatch": {
          "const": true
        },
        "parentTranscriptInherited": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}

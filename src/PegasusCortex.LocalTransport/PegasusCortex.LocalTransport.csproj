<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Pegasus.Cortex.LocalTransport</PackageId>
    <Title>Pegasus Cortex Local Transport</Title>
    <Description>Current-user-only framed IPC for standalone Pegasus Cortex.</Description>
    <Authors>Pegasus</Authors>
    <IsPackable>true</IsPackable>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
